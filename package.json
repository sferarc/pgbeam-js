{
  "name": "pgbeam",
  "version": "0.10.2",
  "description": "TypeScript SDK for the PgBeam API, a Postgres proxy for safe AI agent access with policy enforcement in the wire protocol",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/operations.d.mts",
        "default": "./dist/operations.mjs"
      },
      "require": {
        "types": "./dist/operations.d.cts",
        "default": "./dist/operations.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai-agents",
    "mcp",
    "database-security",
    "pgbeam",
    "postgresql",
    "postgres",
    "proxy",
    "sdk",
    "api-client"
  ],
  "homepage": "https://pgbeam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sferarc/pgbeam-js.git"
  },
  "bugs": {
    "url": "https://github.com/sferarc/pgbeam-js/issues"
  },
  "scripts": {
    "build": "bunchee",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {}
}
